<div class="card m-2" id="comments-new">
    <div class="card-body">
        <!-- 댓글 작성 폼-->
        <form>
            <!-- 닉네임 입력 -->
            <div class="mb-3">
                <label class="form-label">닉네임</label>
                <input type="text" class="form-control form-control-sm" id="new-comment-nickname">
            </div>
            <!-- 댓글 본문 입력 -->
            <div class="mb-3">
                <label class="form-label">댓글 내용</label>
                <textarea type="text" class="form-control form-control-sm" rows="3" id="new-comment-body"></textarea>
            </div>
            <!-- 히든 인풋 -->
            {{#article}}
                <input type="hidden" id="new-comment-article-id" value="{{id}}">
            {{/article}}
            <!-- 전송 버튼 -->
            <button type="button" class="btn btn-outline-primary btn-sm" id="comment-create-btn">댓글 작성</button>
        </form>
    </div>
</div>
<script>
{
  // 댓글 생성 버튼 변수화
  const commentCreateBtn = document.querySelector("#comment-create-btn");
  // 댓글 클릭 이벤트 감지!
  commentCreateBtn.addEventListener("click", function() {
    // 입력 요소 선택
    const nicknameInput = document.querySelector("#new-comment-nickname");
    const bodyInput = document.querySelector("#new-comment-body");

    // 앞뒤 공백 제거 후 값 가져오기
    const nickname = nicknameInput.value.trim();
    const body = bodyInput.value.trim();

    // 입력값 검증: 비어 있으면 등록 중단
    if (nickname === "") {
      alert("닉네임을 입력해주세요.");
      nicknameInput.focus();
      return;
    }
    if (body === "") {
      alert("댓글 내용을 입력해주세요.");
      bodyInput.focus();
      return;
    }

    // 새 댓글 객체 생성
    const comment = {
      nickname: nickname,
      body: body,
      article_id: document.querySelector("#new-comment-article-id").value
    };
    console.log(comment);

    // fetch() - 비동기 통신을 위한 API (REST API 방식.)
    const url = "/api/articles/" + comment.article_id + "/comments";
    fetch(url, {
      method: "post",
      body: JSON.stringify(comment),  // comment js 객체를 json으로 변환하여 보냄.
      headers: {
        "Content-Type": "application/json"
      }
    }).then(response => {
      // http 응답 코드에 따른 메시지 출력
      const msg = (response.ok) ? "댓글이 등록되었습니다." : "댓글 등록 실패..!";
      alert(msg);
      // 현재 페이지 새로고침
      window.location.reload();
    });
  });
}
</script>